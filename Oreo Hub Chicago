local success, err = pcall(function()
    -- ===== TÌM PART =====
    local function findPart(name)
        local folder = workspace:FindFirstChild(FOLDER)
        if folder then
            local p = folder:FindFirstChild(name)
            if p and p:IsA("BasePart") then return p end
        end
        for _, child in ipairs(workspace:GetDescendants()) do
            if child.Name == name and child:IsA("BasePart") then
                return child
            end
        end
        return nil
    end

    -- ===== LẤY VỊ TRÍ MẶT ĐẤT =====
    local function getGroundPosition(pos)
        local ray = Ray.new(pos + Vector3.new(0, 15, 0), Vector3.new(0, -30, 0))
        local hit, hitPos = workspace:FindPartOnRay(ray, player.Character)
        if hit and hitPos then
            return hitPos
        end
        return pos
    end

    -- ===== DI CHUYỂN TỪ TỪ =====
    local function moveTo(targetCF)
        local char = player.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        local startCF = hrp.CFrame
        for i = 1, MOVE_STEPS do
            local t = i / MOVE_STEPS
            hrp.CFrame = startCF:Lerp(targetCF, t)
            task.wait(MOVE_DELAY)
        end
        hrp.CFrame = targetCF
        return true
    end

    -- ===== TƯƠNG TÁC HỘP (GIỮ E ĐÚNG CÁCH) =====
    local function interactWithBox(targetPos)
        local char = player.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return false end

        -- Lấy vị trí mặt đất
        local groundPos = getGroundPosition(targetPos)
        local standHeight = groundPos.Y + STAND_OFFSET

        -- 1. Bay đến vị trí trên hộp
        local flyTarget = CFrame.new(Vector3.new(targetPos.X, targetPos.Y + FLY_HEIGHT, targetPos.Z))
        moveTo(flyTarget)
        task.wait(0.15)

        -- 2. Hạ xuống đứng sát hộp
        local standTarget = CFrame.new(Vector3.new(targetPos.X, standHeight, targetPos.Z))
        moveTo(standTarget)
        task.wait(0.3)

        -- 3. Giải phóng ràng buộc để tương tác
        hrp.Anchored = false
        hum.PlatformStand = false
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end

        -- 4. Đợi vật lý ổn định
        task.wait(0.3)

        -- 5. GIỮ E LIÊN TỤC (QUAN TRỌNG)
        local vim = game:GetService("VirtualInputManager")
        if vim then
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)  -- Bấm giữ
            task.wait(HOLD_E_TIME)                               -- Giữ trong 3s
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game) -- Thả ra
        elseif keypress and keyrelease then
            keypress(Enum.KeyCode.E)
            task.wait(HOLD_E_TIME)
            keyrelease(Enum.KeyCode.E)
        end

        -- 6. Chờ thêm 0.5s để hộp biến mất
        task.wait(0.5)

        -- 7. Khôi phục trạng thái bay
        hrp.Anchored = true
        hum.PlatformStand = true
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        -- 8. Bay lên lại
        moveTo(flyTarget)
        return true
    end

    -- ===== ĐÓNG BĂNG =====
    local function freezeCharacter(freeze)
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        if freeze then
            if not originalState.Saved then
                originalState.Anchored = hrp.Anchored
                originalState.CanCollide = {}
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        originalState.CanCollide[part] = part.CanCollide
                    end
                end
                originalState.PlatformStand = hum.PlatformStand
                originalState.WalkSpeed = hum.WalkSpeed
                originalState.JumpPower = hum.JumpPower
                originalState.Saved = true
            end

            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            hum.PlatformStand = true
            hrp.Anchored = true

            if keepAliveLoop then task.cancel(keepAliveLoop) end
            keepAliveLoop = task.spawn(function()
                while isFarming and hrp and hrp.Parent do
                    hrp.Anchored = true
                    hum.PlatformStand = true
                    task.wait(0.05)
                end
            end)
        else
            if keepAliveLoop then task.cancel(keepAliveLoop); keepAliveLoop = nil end
            for part, val in pairs(originalState.CanCollide) do
                if part and part.Parent then
                    part.CanCollide = val
                end
            end
            hum.PlatformStand = originalState.PlatformStand or false
            hum.WalkSpeed = originalState.WalkSpeed or 16
            hum.JumpPower = originalState.JumpPower or 50
            hrp.Anchored = originalState.Anchored or false
        end
    end

    -- ===== FARM LOOP =====
    local function farmTask()
        while isFarming do
            freezeCharacter(true)

            local getPart = findPart(PART_GET)
            if getPart then
                interactWithBox(getPart.Position)
                task.wait(0.3)
            end

            local targetPart = findPart(PART_TARGET)
            if targetPart then
                interactWithBox(targetPart.Position)
                task.wait(0.3)
            end

            print("[Oreo] ✅ Farm cycle done")
            task.wait(CYCLE_DELAY)
        end
    end

    local function startFarm()
        if farmLoop then task.cancel(farmLoop); farmLoop = nil end
        isFarming = true
        freezeCharacter(true)
        farmLoop = task.spawn(farmTask)
        print("[Oreo] 🟢 Farm started (giữ E 3s)")
    end

    local function stopFarm()
        isFarming = false
        if farmLoop then
            task.cancel(farmLoop)
            farmLoop = nil
        end
        freezeCharacter(false)
        print("[Oreo] 🔴 Farm stopped")
    end

    -- ===== GÁN SỰ KIỆN FARM =====
    local afkState = false
    afBtn.MouseButton1Click:Connect(function()
        afkState = not afkState
        afStatus.Text = afkState and "ON" or "OFF"
        afStatus.TextColor3 = afkState and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 50, 50)
        afBtn.BackgroundColor3 = afkState and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(60, 60, 80)
        afBtn.Text = afkState and "ON" or "OFF"
        if afkState then
            startFarm()
        else
            stopFarm()
        end
    end)

    -- Anti-AFK
    local aafkState = false
    aafkBtn.MouseButton1Click:Connect(function()
        aafkState = not aafkState
        aafkStatus.Text = aafkState and "ON" or "OFF"
        aafkStatus.TextColor3 = aafkState and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 50, 50)
        aafkBtn.BackgroundColor3 = aafkState and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(60, 60, 80)
        aafkBtn.Text = aafkState and "ON" or "OFF"
        if aafkState then
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:ClickButton2(Vector2.new())
            print("[Oreo] Anti-AFK ON")
        else
            print("[Oreo] Anti-AFK OFF")
        end
    end)

    -- Anti-Lag
    local alagState = false
    alagBtn.MouseButton1Click:Connect(function()
        alagState = not alagState
        alagStatus.Text = alagState and "ON" or "OFF"
        alagStatus.TextColor3 = alagState and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 50, 50)
        alagBtn.BackgroundColor3 = alagState and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(60, 60, 80)
        alagBtn.Text = alagState and "ON" or "OFF"
        if alagState then
            settings().Rendering.QualityLevel = 1
            print("[Oreo] Anti-Lag ON")
        else
            settings().Rendering.QualityLevel = 21
            print("[Oreo] Anti-Lag OFF")
        end
    end)

    print("[Oreo] ✅ Farm functions loaded!")
end)

