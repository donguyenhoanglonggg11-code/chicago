pcall(function()
    local function createEsp(target)
        local char = target.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local box = Instance.new("BoxHandleAdornment")
        box.Adornee = hrp
        box.Size = Vector3.new(3, 5, 1.5)
        box.Color3 = Color3.fromRGB(255, 255, 255)
        box.Transparency = 0.5
        box.ZIndex = 0
        box.Parent = hrp

        local nameTag = Instance.new("BillboardGui")
        nameTag.Adornee = hrp
        nameTag.Size = UDim2.new(0, 100, 0, 30)
        nameTag.StudsOffset = Vector3.new(0, 3, 0)
        nameTag.Parent = hrp

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = target.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.Parent = nameTag

        return box, nameTag
    end

    local function clearEsp()
        for _, v in ipairs(espLines) do
            if v and v.Parent then
                v:Destroy()
            end
        end
        espLines = {}
    end

    local function updateEsp()
        if not espEnabled then return end
        clearEsp()
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr ~= player then
                local box, nameTag = createEsp(plr)
                if box then table.insert(espLines, box) end
                if nameTag then table.insert(espLines, nameTag) end
            end
        end
    end

    local function startEsp()
        espEnabled = true
        updateEsp()
        if espLoop then task.cancel(espLoop) end
        espLoop = task.spawn(function()
            while espEnabled do
                updateEsp()
                task.wait(1)
            end
        end)
        print("[Oreo] ESP ON")
    end

    local function stopEsp()
        espEnabled = false
        if espLoop then task.cancel(espLoop); espLoop = nil end
        clearEsp()
        print("[Oreo] ESP OFF")
    end

    local espState = false
    espEnableBtn.MouseButton1Click:Connect(function()
        espState = not espState
        espStatus.Text = espState and "ON" or "OFF"
        espStatus.TextColor3 = espState and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 50, 50)
        espEnableBtn.BackgroundColor3 = espState and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(60, 60, 80)
        espEnableBtn.Text = espState and "ON" or "OFF"
        if espState then
            startEsp()
        else
            stopEsp()
        end
    end)

    print("[Oreo] ✅ ESP functions loaded!")
end)

