-- ===== TAB SWITCHING =====
local function selectTab(name)
    mainContent.Visible = false
    settingsContent.Visible = false
    aimbotContent.Visible = false
    espContent.Visible = false
    aboutContent.Visible = false
    tabMain.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    tabSettings.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    tabAimbot.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    tabEsp.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    tabAbout.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    tabMain.TextColor3 = Color3.fromRGB(180, 180, 220)
    tabSettings.TextColor3 = Color3.fromRGB(180, 180, 220)
    tabAimbot.TextColor3 = Color3.fromRGB(180, 180, 220)
    tabEsp.TextColor3 = Color3.fromRGB(180, 180, 220)
    tabAbout.TextColor3 = Color3.fromRGB(180, 180, 220)

    if name == "Main" then
        mainContent.Visible = true
        tabMain.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        tabMain.BackgroundTransparency = 0.3
        tabMain.TextColor3 = Color3.fromRGB(255, 255, 255)
    elseif name == "Settings" then
        settingsContent.Visible = true
        tabSettings.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        tabSettings.BackgroundTransparency = 0.3
        tabSettings.TextColor3 = Color3.fromRGB(255, 255, 255)
    elseif name == "Aimbot" then
        aimbotContent.Visible = true
        tabAimbot.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        tabAimbot.BackgroundTransparency = 0.3
        tabAimbot.TextColor3 = Color3.fromRGB(255, 255, 255)
    elseif name == "ESP" then
        espContent.Visible = true
        tabEsp.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        tabEsp.BackgroundTransparency = 0.3
        tabEsp.TextColor3 = Color3.fromRGB(255, 255, 255)
    elseif name == "About" then
        aboutContent.Visible = true
