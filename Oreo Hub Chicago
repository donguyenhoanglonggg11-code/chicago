-- ===== PHẦN CHỨC NĂNG AIMBOT =====
-- ============================================
pcall(function()
    local function getPlayers()
        local players = {}
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(players, plr)
            end
        end
        return players
    end

    local function getClosestPlayer()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end

        local origin = hrp.Position
        local players = getPlayers()
        local closest = nil
        local closestDist = aimbotFOV

        for _, plr in ipairs(players) do
            local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                local targetPos = targetHrp.Position
                local direction = (targetPos - origin).Unit
                local lookVector = camera.CFrame.LookVector
                local angle = math.acos(math.clamp(lookVector:Dot(direction), -1, 1))
                local angleDeg = math.deg(angle)

                if angleDeg < closestDist then
                    closestDist = angleDeg
                    closest = plr
                end
            end
        end
        return closest
    end

    local function aimAt(target)
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp or not target then return end
        local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not targetHrp then return end

        local targetPos = targetHrp.Position + Vector3.new(0, 1.5, 0)
        local currentCF = camera.CFrame
        local targetCF = CFrame.lookAt(currentCF.Position, targetPos)

        local lerpFactor = math.clamp(aimbotSpeed, 0.01, 0.99)
        camera.CFrame = currentCF:Lerp(targetCF, lerpFactor)
    end

    local function aimbotTask()
        while aimbotEnabled do
            if isAiming then
                local target = getClosestPlayer()
                if target then
                    aimAt(target)
                end
            end
            task.wait()
        end
    end

    local function toggleAimbot(state)
        aimbotEnabled = state
        if state then
            if aimbotLoop then task.cancel(aimbotLoop); aimbotLoop = nil end
            aimbotLoop = task.spawn(aimbotTask)
            print("[Oreo] Aimbot ON")
        else
            if aimbotLoop then task.cancel(aimbotLoop); aimbotLoop = nil end
            print("[Oreo] Aimbot OFF")
        end
    end

    -- Sự kiện
    local aimState = false
    aimEnableBtn.MouseButton1Click:Connect(function()
        aimState = not aimState
        aimEnableStatus.Text = aimState and "ON" or "OFF"
        aimEnableStatus.TextColor3 = aimState and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 50, 50)
        aimEnableBtn.BackgroundColor3 = aimState and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(60, 60, 80)
        aimEnableBtn.Text = aimState and "ON" or "OFF"
        toggleAimbot(aimState)
    end)

    fovSlider.FocusLost:Connect(function()
        local val = tonumber(fovSlider.Text)
        if val and val > 0 and val <= 360 then
            aimbotFOV = val
            fovLabel.Text = "FOV: " .. val
        else
            fovSlider.Text = tostring(aimbotFOV)
        end
    end)

    speedSlider.FocusLost:Connect(function()
        local val = tonumber(speedSlider.Text)
        if val and val >= 0 and val <= 1 then
            aimbotSpeed = val
            speedLabel.Text = "Speed: " .. string.format("%.2f", val)
        else
            speedSlider.Text = string.format("%.2f", aimbotSpeed)
        end
    end)

    userInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            if aimState then
                isAiming = true
            end
        end
    end)

    userInputService.InputEnded:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            isAiming = false
        end
    end)

    print("[Oreo] ✅ Aimbot functions loaded!")
end)

